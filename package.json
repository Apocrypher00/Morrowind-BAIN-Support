{
    "name": "morrowind-bain-support",
    "version": "1.1.0",
    "description": "Support for Morrowind mods with BAIN installers",
    "main": "./dist/index.js",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "webpack": "webpack --config webpack.config.js",
        "build": "npm run typecheck && npm run webpack && extractInfo",
        "package": "npm run build && node scripts/package.js"
    },
    "author": "Apocrypher00",
    "license": "Unlicense",
    "devDependencies": {
        "@types/node": "^12.12.35",
        "@types/react": "^16.9.43",
        "@types/react-bootstrap": "^0.32.20",
        "@types/redux": "^3.6.0",
        "@types/redux-thunk": "^2.1.0",
        "bluebird": "^3.7.2",
        "i18next": "^19.0.1",
        "react": "^16.12.0",
        "react-bootstrap": "^0.33.0",
        "react-dom": "^16.12.0",
        "ts-loader": "9.6.2",
        "typescript": "6.0.3",
        "vortex-api": "git+https://github.com/Nexus-Mods/vortex-api.git#efe8a33b0f6b8507fcbd797553cd6c48b5e26476",
        "webpack": "5.112.0",
        "webpack-cli": "7.2.3",
        "yazl": "3.3.1"
    },
    "config": {
        "extensionName": "Morrowind BAIN Support"
    },
    "engines": {
        "node": ">=20.9.0"
    }
}
