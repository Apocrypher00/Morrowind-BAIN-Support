{
    "name": "morrowind-bain-support",
    "version": "1.1.0",
    "description": "Support for Morrowind mods with BAIN installers",
    "main": "./dist/index.js",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "webpack": "webpack --config webpack.config.js",
        "build": "npm run typecheck && npm run webpack && extractInfo",
        "package": "npm run build && node scripts/package.mjs"
    },
    "author": "Apocrypher00",
    "license": "Unlicense",
    "devDependencies": {
        "@nexusmods/vortex-api": "2.9.0",
        "@types/bluebird": "3.5.20",
        "@types/node": "^12.12.35",
        "ts-loader": "9.6.2",
        "typescript": "6.0.3",
        "webpack": "5.112.0",
        "webpack-cli": "7.2.3",
        "yazl": "3.3.1"
    },
    "config": {
        "extensionName": "Morrowind BAIN Support"
    },
    "engines": {
        "node": ">=20.9.0"
    }
}
