{
    "compilerOptions": {
        "target": "es2019",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "rootDir": "src",
        "outDir": "./out",
        "sourceMap": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false,
        "types": [
            "node"
        ]
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src/index.ts"
    ]
}
