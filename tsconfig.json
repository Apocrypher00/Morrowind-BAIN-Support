{
    "compilerOptions": {
        "target": "es2019",
        "module": "Node16",
        "moduleResolution": "Node16",
        "noImplicitAny": false,
        "removeComments": true,
        "preserveConstEnums": true,
        "rootDir": "src",
        "outDir": "./out",
        "jsx": "react",
        "sourceMap": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": false
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "src/index.ts"
    ]
}
